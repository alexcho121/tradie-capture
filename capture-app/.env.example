# Production providers. Set model IDs and the API key in local .env.
DATA_DIR=./data
STT_PROVIDER=openai
STT_MODEL=
EXTRACT_PROVIDER=openai
EXTRACT_MODEL=
OPENAI_API_KEY=
RATE_LIMIT_PER_HOUR=60
CORS_ORIGINS=*

# Best-effort reverse geocoding after capture. Set a deployment-specific identifier.
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=TradieCapture/0.1
GEOCODER_TIMEOUT_SECONDS=4
